{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "0.1.0",
  "description": "__MSG_extensionDescription__",
  "default_locale": "zh_TW",
  "icons": {
    "128": "icons/icon.png"
  },
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "downloads"
  ],
  "action": {
    "default_title": "__MSG_extensionName__",
    "default_icon": {
      "128": "icons/icon.png"
    },
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://music.youtube.com/*"
      ],
      "css": [
        "content.css"
      ],
      "js": [
        "src/feature-rating-buttons.js"
      ],
      "run_at": "document_start"
    }
  ]
}
